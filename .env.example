# Runtime
SPRING_PROFILES_ACTIVE=production
APPLICATION_NAME=educue
SERVER_PORT=8080
APP_TIME_ZONE=Africa/Nairobi
FORWARD_HEADERS_STRATEGY=framework
SHUTDOWN_TIMEOUT=30s

# Database
DB_URL=jdbc:postgresql://database-host:5432/educue
DB_USERNAME=educue_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=30000

# Authentication
# Generate at least 64 cryptographically random bytes and Base64-encode them.
JWT_SECRET=replace-with-a-long-base64-secret
JWT_EXPIRATION_MINUTES=60
AUTH_COOKIE_SECURE=true

# Public URLs and CORS
FRONTEND_BASE_URL=https://portal.example.edu
PUBLIC_BASE_URL=https://api.example.edu
CORS_ALLOWED_ORIGINS=https://portal.example.edu
DEFAULT_AVATAR_URL=https://ui-avatars.com/api/?background=e8eef7&color=17365d&name=User

# Bootstrap administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-strong-password
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator

# Password-reset email / SMTP
PASSWORD_RESET_MAIL_ENABLED=true
EXPOSE_PASSWORD_RESET_TOKEN=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.edu
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000

# Cloudinary — the application's only persistent file store
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=25MB

# Admission document queue
ADMISSION_WORKER_DELAY_MS=2000
ADMISSION_RECOVERY_DELAY_MS=60000

# Finance
FINANCE_RECEIPT_PREFIX=MB02

# M-Pesa / Daraja
MPESA_BASE_URL=https://api.safaricom.co.ke
MPESA_C2B_REGISTER_PATH=/mpesa/c2b/v1/registerurl
MPESA_CONSUMER_KEY=replace-with-daraja-consumer-key
MPESA_CONSUMER_SECRET=replace-with-daraja-consumer-secret
MPESA_C2B_SHORT_CODE=replace-with-c2b-short-code
MPESA_STK_SHORT_CODE=replace-with-stk-short-code
MPESA_STK_PASSKEY=replace-with-stk-passkey
MPESA_STK_CALLBACK_TOKEN=replace-with-a-random-callback-token
MPESA_CALLBACK_TOKEN=replace-with-a-different-random-callback-token
MPESA_PHONE_HASH_PEPPER=replace-with-at-least-32-random-bytes
MPESA_WORKER_DELAY_MS=500
MPESA_RECOVERY_DELAY_MS=60000

# Logging and actuator
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=WARN
HEALTH_SHOW_DETAILS=never
